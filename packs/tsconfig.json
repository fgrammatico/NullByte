{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./behavior_pack/scripts",
    "strict": true,
    "lib": ["ES2020"],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
